<%- include('./partials/header') %>
    

<div  class="bg-zinc-800 min-h-screen text-white" >
<div class="max-w-2xl mx-auto px-4 py-10">

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold ">
        My Todo List
      </h1>
      <p class="text-gray-500 mt-1">
        Keep track of your tasks
      </p>
    </div>

    <!-- Add Todo -->
    <div class="bg-white rounded-xl shadow-sm p-4 mb-6">
      <form class="flex gap-3" method="post" action="/todo">
        <input
          type="text"
          name="todoName"
          placeholder="What needs to be done?"
          class="flex-1 border border-gray-300 rounded-lg px-4 py-3
                 outline-none focus:ring-2 focus:ring-blue-500
                 focus:border-blue-500 text-black"
        />

        <button
          type="submit"
          class="bg-blue-600 text-white px-6 py-3 rounded-lg
                 font-medium hover:bg-blue-700 transition"
        >
          Add
        </button>
      </form>
    </div>

    <!-- Todo List -->
    <div class="space-y-3">
     <% todos.forEach(function(todo) { %>
      <!-- Todo 1 -->
      <div class="bg-white rounded-xl shadow-sm p-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <input
            type="checkbox"
            class="w-5 h-5 accent-blue-600"
            data-id = "<%= todo._id %>"
            <%= todo.completed ? 'checked' : '' %>
          />

          <div>
            <h3 class="font-medium text-gray-900">
              <%= todo.content %> 
            </h3>
     
          </div>
        </div>

        <a href="/todo/delete/<%=todo._id%>"
          class="text-red-500 hover:text-red-700 font-medium"
        >
          Delete
        </a>
      </div>

  

   <% }) %>

    </div>

    <!-- Empty state -->
    <!--
    <div class="bg-white rounded-xl p-10 text-center shadow-sm">
      <p class="text-gray-500">
        No todos yet. Add your first todo!
      </p>
    </div>
    -->

  </div>
</div>

<%- include('./partials/footer') %>