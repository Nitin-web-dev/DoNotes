<!DOCTYPE html>
<html lang="en">

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authentication</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  
</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
              <h3 class="text-3xl mb-5">Create User</h3>
              
        <form class="" method="post" action="/SignUp">
            <input class=" border-zinc-600 px-3 py-2 rounded-md border-2 transparent" type="text" name="userName" placeholder="userName">
            <input class=" border-zinc-600 px-3 py-2 rounded-md border-2 transparent" type="email" name="email" placeholder="email">
            <input class=" border-zinc-600 px-3 py-2 rounded-md border-2 transparent" type="password" name="password" placeholder="password">
            
            <input class=" border-zinc-600 px-3 py-2 rounded-md border-2 bg-blue-500" type="submit" value="create user">
        </form>
    </div>

</body>
</html>